PORT=8000
FRONTEND_URL=http://localhost:3000
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/xar-books

# signs the login cookie. Generate one with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# email account for password reset links.
# leave SMTP_HOST empty in development and the link prints in the terminal instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Xar Books <no-reply@example.com>
